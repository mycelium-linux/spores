// The controller's world: a GPUI view and one bounded HTTP origin.
//
// There is no `soil:vfs` import on purpose: a local track is named by the path
// MPD already uses, and the catalog (deadwax serve) owns every read. There is no
// `soil:playback` import either — the host that runs this package does not carry
// it, and the same catalog already exposes MPD's transport over HTTP, so one
// data path serves both this Spore and the native controller.
package fungos:deadwax@0.1.0;

world runner {
  import soil:present/surface@0.1.0;
  import soil:present/input@0.1.0;
  import soil:present/cursor@0.1.0;
  import soil:http/http@0.1.0;
  export run: async func() -> u32;
}
