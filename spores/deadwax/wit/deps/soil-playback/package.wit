// Household playback transport for a Spore.
//
// The host owns the audio device, the queue writer, the account a source needs,
// and the Unibus session. The Spore owns the interaction: what to play, in what
// order, and what the person sees. A Spore never receives a path, an endpoint,
// a token, a peer id, or a sample of audio; it names tracks by identity and the
// owner resolves them.
//
// This is the guest side of Unibus's `audio.playback.state.v1`,
// `audio.playback.event.v1`, and `audio.playback.command.v1`. A host that runs
// the `soil:unibus` profile fills `events` from those kinds; an owner that is
// local-only can satisfy the same interface without a bus. The shapes match the
// wire contract field for field so the bridge needs no translation table.
//
// `soil:media` is a different, lower contract: one host-decoded source. A
// playback owner may use it internally to play the track this interface
// selected; a controller does not.
package soil:playback@0.1.0;

interface types {
  /// Where a track's bytes and metadata come from.
  enum source {
    /// A canonical master, addressed by CID.
    local,
    /// A Spotify item, addressed by URI.
    spotify,
  }

  enum repeat {
    off,
    track,
    queue,
  }

  enum error {
    /// The Spore has no `soil:playback` grant, or may not address this owner.
    denied,
    /// No owner, device, peer, or account is reachable.
    unavailable,
    /// The command or track identity is malformed.
    invalid,
    /// The command was written against a revision that has moved on.
    stale,
    /// The owner cannot do this with the selected source.
    unsupported,
    /// Decode, network, or device failure after the request was accepted.
    failed,
    /// The session is alive but its output is held by another authority (the
    /// studio, a call, a system lock). The queue may keep moving; the media
    /// keys are unaffected.
    blocked,
  }

  /// One playable item, named by identity rather than by location.
  record track {
    source: source,
    /// CIDv1 (raw, sha2-256, 59 characters) for `local`; a Spotify URI
    /// (`spotify:track:…` or `spotify:episode:…`) for `spotify`.
    id: string,
    title: string,
    artist: string,
    album: option<string>,
    duration-ms: option<u64>,
    /// Cover art: a CID for `local`, an https URL for `spotify`. Resolved by
    /// whoever draws it, not embedded here.
    art: option<string>,
  }

  record queue-entry {
    track: track,
    /// Who asked for it, when the owner keeps that. Never a credential.
    requested-by: option<string>,
  }

  /// One playhead on the desk.
  record session-ref {
    /// The app or node that holds the queue: `deadwax`, `spotify`, `synesthesia`.
    owner: string,
    /// The playhead inside that owner: `main`, `arrange`, `preview`.
    session: string,
  }

  /// What one session can honour. A global verb that is not supported fails
  /// with `unsupported`; it is never reinterpreted as a different action.
  record session-capability {
    can-play: bool,
    can-pause: bool,
    can-next: bool,
    can-previous: bool,
    can-seek: bool,
    has-volume: bool,
    can-search: bool,
  }

  /// One active concept on the desk. Several can be playing at once; exactly
  /// one is focused for global transport.
  record session {
    target: session-ref,
    /// What a person sees, e.g. `Library`, `Spotify`, `Synesthesia`.
    label: string,
    /// `library`, `spotify`, `studio`, ... A controller may style by kind but
    /// must not assume a vocabulary.
    kind: string,
    playing: bool,
    focused: bool,
    capability: session-capability,
  }

  /// The owner's snapshot. Authoritative: an event is a hint that this changed.
  record state {
    /// Which session this playhead belongs to.
    target: session-ref,
    /// Monotonic within one session. A restart starts a new generation.
    revision: u64,
    source: source,
    playing: bool,
    position-ms: u64,
    /// Normalized 0..=1; `none` when the owner has no volume control.
    volume: option<f32>,
    repeat: repeat,
    shuffle: bool,
    current: option<track>,
    /// The cursor in `queue`, when the current track came from it.
    index: option<u32>,
    /// Bounded by the host (200 entries in the matching Unibus contract).
    queue: list<queue-entry>,
  }

  /// What one source can do. Support is not reachability: a listed source may
  /// still fail `snapshot` with `unavailable` when no device or account is live.
  record capability {
    source: source,
    /// What a person sees, e.g. `Library` or `Spotify`.
    label: string,
    can-search: bool,
    can-seek: bool,
    has-volume: bool,
  }

  /// Replace the queue. `start` is an index into `entries`.
  record queue-request {
    entries: list<queue-entry>,
    start: u32,
  }

  record enqueue-request {
    entry: queue-entry,
    /// True to put it after the current track instead of at the end.
    next: bool,
  }

  variant command {
    play,
    pause,
    toggle,
    stop,
    next,
    previous,
    /// Position in milliseconds.
    seek(u64),
    /// Normalized 0..=1.
    volume(f32),
    set-repeat(repeat),
    shuffle(bool),
    set-queue(queue-request),
    enqueue(enqueue-request),
    select-source(source),
  }

  record position {
    revision: u64,
    position-ms: u64,
    playing: bool,
  }

  /// A change since the last snapshot. Small on purpose: the playhead moves
  /// every second, and a consumer that misses one reads `snapshot` again.
  variant event {
    /// A structural change in the focused session: track, queue, repeat.
    snapshot(state),
    /// The playhead moved, or a seek landed.
    progress(position),
    volume(f32),
    failed(error),
    /// Global transport moved to another session (or nowhere). A controller
    /// re-reads `desk.sessions` and `player.snapshot` when this arrives.
    focus(option<session-ref>),
  }
}

interface player {
  use types.{capability, command, error, source, state, track};

  /// What the focused session can drive. A UI that needs every concept uses
  /// `desk.sessions` instead; this is the simple-controller view.
  sources: func() -> list<capability>;

  /// The focused session's authoritative snapshot. Cheap enough to call when
  /// the view opens instead of waiting for the first event.
  snapshot: func() -> result<state, error>;

  /// Send one transport command. The owner answers with the revision the
  /// command was admitted against; the resulting snapshot arrives through
  /// `events`. A command written against a moved revision fails with `stale`
  /// rather than landing on a queue it was not written for.
  send: func(command: command) -> result<u64, error>;

  /// Search one source. The host owns the credentials and the network, so a
  /// Spotify search does not put a token in the guest. `limit` is bounded by
  /// the host; a source without `can-search` fails with `unsupported`.
  search: func(source: source, query: string, limit: u32) -> result<list<track>, error>;
}

interface events {
  use types.{event};

  /// True while an owner is attached. A capture host with no owner returns
  /// false and the Spore still draws its library.
  attached: func() -> bool;

  /// Wait up to `timeout-ms` for the next event. Zero polls without waiting.
  /// The wait happens even with no owner attached, so a live Spore can use this
  /// as its frame clock instead of spinning.
  poll: func(timeout-ms: u32) -> option<event>;
}

/// The desk: every active concept and which one global transport addresses.
/// A controller that shows only the focused playhead can ignore this; a
/// session switcher or a studio view needs it.
interface desk {
  use types.{error, session, session-ref};

  /// Every session the host knows, in the order a UI should show it.
  sessions: func() -> list<session>;

  /// The session global transport addresses, when there is one.
  focused: func() -> option<session-ref>;

  /// Ask the arbiter to focus a session. A user request; the arbiter may still
  /// refuse when the session has left the desk. The decision arrives through
  /// `events.focus`.
  focus: func(target: session-ref) -> result<_, error>;
}

world guest {
  import player;
  import events;
  import desk;
}

world host {
  import player;
  import events;
  import desk;
}
