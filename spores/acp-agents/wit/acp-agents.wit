// Theseus adapter. Each exported interface carries the records it uses, so a
// composing host does not need a separate type-only provider.
package fungos:acp-agents@0.1.0;

interface observe {

  enum error {
    /// The read or control grant was not linked.
    denied,
    /// No agent with that id is visible to this host.
    not-found,
    /// The adapter is not attached yet, or the harness is starting.
    not-ready,
    /// An id, prompt, answer, or page limit is malformed or outside bounds.
    invalid,
    /// The page, transcript, or answer exceeds the host's budget.
    over-budget,
    /// The prompt was already answered or withdrawn; the agent has moved on.
    stale,
    /// This harness cannot do that (an adapter with no interrupt channel).
    unsupported,
    /// The adapter or harness failed.
    io,
  }

  /// Where an agent is in its turn.
  ///
  /// `needs-you` is the only phase that implies a non-empty `prompts` list, and
  /// a non-empty `prompts` list always implies `needs-you`. An adapter that
  /// cannot represent an approval natively still satisfies the invariant: it
  /// synthesizes a prompt (for example from a terminal `blocked` report) and
  /// resolves it when the answer reaches the harness by whatever channel that
  /// harness has.
  enum phase {
    /// The adapter is attaching; nothing is known past identity yet.
    connecting,
    /// Ready, no turn in flight.
    idle,
    /// A model request is in flight.
    thinking,
    /// Tools are running inside the current turn.
    working,
    /// The agent cannot continue without a person.
    needs-you,
    /// The turn ended and the harness reported the work complete.
    finished,
    /// The turn ended in an error, a refusal, or a dead adapter.
    failed,
    /// Stopped on purpose: by a person, a budget, or a schedule.
    paused,
  }

  /// The station vocabulary of an agent's timeline.
  ///
  /// Fixed here so that every harness and every view agree on what a lit Files
  /// station means. The adapter classifies; the view only draws. `other` is for
  /// work that fits no station, and takes its label from the harness.
  enum activity-kind {
    you,
    model,
    memory,
    files,
    shell,
    network,
    browser,
    agent,
    skill,
    hook,
    other,
  }

  enum status {
    running,
    ok,
    failed,
    blocked,
  }

  enum avatar-kind {
    image,
    animation,
    glyph,
  }

  /// A view-resolvable icon. Never inline bytes and never a tracking URL.
  record avatar {
    kind: avatar-kind,
    /// Stable handle resolved through soil:assets or a Spore asset table.
    asset: option<string>,
    /// MIME type of the asset when known.
    mime: option<string>,
    /// Short fallback: initials, a symbol name, or one grapheme.
    glyph: option<string>,
    /// Alt text, always present.
    alt: string,
    /// True for GIF/APNG/WebP animation.
    animated: bool,
  }

  /// One thing that happened, at one station.
  ///
  /// `label` is a name, never content: a tool name, a harness step, two path
  /// segments, a host. Folding neighbouring repeats into one row is a view
  /// decision; the host reports what happened.
  record activity {
    kind: activity-kind,
    label: string,
    detail: option<string>,
    status: status,
    started-at-ms: u64,
    finished-at-ms: option<u64>,
  }

  enum prompt-kind {
    /// Open question; the answer is prose.
    question,
    /// Yes or no, about one action.
    approval,
    /// Pick one of `options`.
    choice,
  }

  record choice {
    id: string,
    label: string,
    detail: option<string>,
    /// The option the person should think twice about: it publishes, deletes,
    /// spends, or widens scope.
    danger: bool,
  }

  /// One thing the agent cannot decide alone.
  ///
  /// A prompt is the only way an agent asks for a person. Everything that needs
  /// a decision -- a permission request, a choice between approaches, a
  /// terminal `blocked` report -- is normalized here, so a surface renders one
  /// card shape instead of one per harness.
  record prompt {
    id: string,
    kind: prompt-kind,
    /// One line, the question itself, ready to render.
    title: string,
    /// Prose explanation, if the harness wrote one.
    body: option<string>,
    /// Preformatted evidence: the command, the diff, the failing test. Rendered
    /// monospace and bounded by the host; never a credential.
    details: option<string>,
    /// What raised it: a tool name, a harness step. Not an authority claim.
    origin: option<string>,
    options: list<choice>,
    /// The person may answer in their own words even when options are offered.
    allows-text: bool,
    asked-at-ms: u64,
    /// The harness withdraws the prompt itself; this is the deadline the agent
    /// stated, not a timer the surface enforces.
    deadline-at-ms: option<u64>,
  }

  enum role {
    user,
    assistant,
    tool,
  }

  record turn {
    role: role,
    text: string,
    at-ms: u64,
  }

  record usage {
    /// Prompt tokens in the last model request.
    context-tokens: u64,
    /// The model's window, or 0 when the adapter does not know it.
    context-window: u64,
    input-tokens: u64,
    output-tokens: u64,
    /// Completed assistant turns in this session.
    turns: u32,
    /// Tool calls observed in this session, including failed ones.
    tool-calls: u64,
    /// Tool calls that ended in an error or cancellation.
    tool-errors: u64,
    /// Measured wall time of model calls. Zero means unknown.
    model-time-ms: u64,
  }

  record goal {
    text: string,
    set-at-ms: u64,
  }

  /// Whose agents a surface is showing.
  ///
  /// Chosen by the host, never by the Spore: a surface bound to one principal
  /// and a wall over a shared desktop are different authorities, and the grant
  /// is what decides which one a caller gets.
  enum scope-kind {
    /// This machine, whoever owns the session running on it.
    device,
    /// One desktop session, which may carry agents belonging to several
    /// people. The common case when a machine is shared or handed over.
    desktop,
    /// One principal's agents, wherever they are running.
    principal,
  }

  record scope {
    kind: scope-kind,
    /// Stable id of the device, desktop, or actor. Compared by hosts; never
    /// shown raw.
    id: option<string>,
    /// What a header shows when it names the scope: a desktop name, a person.
    label: option<string>,
    /// The person this surface belongs to, when the host knows one. A wall
    /// uses it to mark the rows that belong to somebody else, which is the
    /// question a shared desktop actually asks.
    owner: option<owner>,
  }

  /// Who an agent belongs to.
  ///
  /// A projection, not an identity: an agent on a shared desktop may belong to
  /// a person this host cannot attest, and a fabricated `soil:principal`
  /// identity would be worse than an honest label. `actor` is stable and
  /// comparable; `display-name` is for people.
  record owner {
    actor: string,
    display-name: option<string>,
  }

  /// One machine a person may place work on.
  ///
  /// Facts, not capacity: `attached` says this host reached that device's agent
  /// service when it opened the surface, and `detail` is why it did not. Nothing
  /// here claims what the device could do later, and no field is a credential.
  record device {
    /// Stable id, compared by hosts; never drawn.
    id: string,
    /// What a header shows.
    label: string,
    /// This host runs on it.
    current: bool,
    /// The device's agent service answered this host.
    attached: bool,
    /// Why it did not answer, when it did not. Host text, bounded by the host.
    detail: option<string>,
  }

  record agent {
    /// Stable for the life of the session, and unique within the host.
    id: string,
    /// Adapter identity: "operator", "pi". Never a name for a person.
    harness: string,
    /// The session's own name, as the harness reports it.
    title: string,
    /// Workspace root, if the harness has one. Host policy may redact this.
    workspace: option<string>,
    model: option<string>,
    /// The device this agent's harness runs on, as the host labels it.
    ///
    /// Absent when the adapter cannot say. A view must not fill it in: "which
    /// machine is this running on" has one answer per agent, and a guess reads
    /// as a fact once it is drawn.
    device: option<string>,
    /// Optional harness-supplied icon. A view generates a deterministic
    /// fallback when it is absent.
    avatar: option<avatar>,
    phase: phase,
    /// What the agent is trying to accomplish now. Absent when the harness has
    /// no notion of a goal and the last user message is the only evidence.
    goal: option<goal>,
    /// Who it belongs to. Present on a shared desktop; a `principal` scope may
    /// leave it out, because every row already belongs to that principal.
    owner: option<owner>,
    /// Oldest first, bounded by the host.
    activity: list<activity>,
    prompts: list<prompt>,
    usage: usage,
    /// Bumped by the host on every change, so a reader can drop a frame it has
    /// already seen and a capture can name what it drew.
    revision: u64,
    started-at-ms: u64,
    updated-at-ms: u64,
  }

  record response {
    /// One of `prompt.options[].id`. Absent for a prose answer.
    choice: option<string>,
    text: option<string>,
  }

  /// A flat view over the prompts in `agents()`, for a dashboard that does not
  /// want to re-derive the queue. It is not a second store.
  record escalation {
    agent-id: string,
    agent-title: string,
    prompt: prompt,
  }

  /// What the host opened this surface for.
  ///
  /// A window dedicated to one agent gets its id; a wall that shows everything
  /// gets none. `view` is a hint the Spore may ignore: views are the Spore's
  /// vocabulary, not the contract's.
  record binding {
    agent: option<string>,
    view: option<string>,
  }

  record page {
    /// Newest last.
    turns: list<turn>,
    /// Cursor for the next older page, or none at the oldest turn.
    before: option<u64>,
  }

  /// The agents this host can see, in the host's own order: agents that need a
  /// person first, then most recently active. A view may reorder; a surface
  /// that only has room for one row should not have to.
  agents: func() -> result<list<agent>, error>;

  /// Every open prompt, flattened with the agent that owns it. This is a view
  /// over `agents()`; it is not a second queue.
  escalations: func() -> result<list<escalation>, error>;

  /// The devices this surface may place work on, in the host's own order.
  ///
  /// Empty when the host was given no device: an adapter that has not thought
  /// about placement offers no choice rather than one silent default. A surface
  /// with no devices leaves its picker out; it does not invent a name.
  devices: func() -> list<device>;

  /// The models the harnesses will accept, in the host's order.
  ///
  /// Only strings a harness advertised: a picker that offered a name nobody
  /// serves would be asking a person to choose a failure. Empty when no
  /// harness named any, and then the picker is left out.
  models: func() -> list<string>;

  get: func(id: string) -> result<agent, error>;

  /// The launch intent the host chose for this surface.
  intent: func() -> binding;

  /// What this surface is allowed to see. A wall over a shared desktop names
  /// the desktop; a session window names the principal it was opened for.
  /// (`current-scope` rather than `scope`: WIT keeps a function and a type in
  /// one interface apart by name, and the record is the useful half to keep.)
  current-scope: func() -> scope;

  /// Conversation text, newest page first. `limit` is bounded by the host; a
  /// Spore asks again with `before` while the person scrolls back.
  transcript: func(id: string, before: option<u64>, limit: u32) -> result<page, error>;

}

interface control {

  enum error {
    denied,
    not-found,
    not-ready,
    invalid,
    over-budget,
    stale,
    unsupported,
    io,
  }

  record response {
    choice: option<string>,
    text: option<string>,
  }

  respond: func(id: string, prompt-id: string, answer: response) -> result<_, error>;
  send: func(id: string, text: string) -> result<_, error>;
  interrupt: func(id: string) -> result<_, error>;

}

interface metrics {
  enum error {
    denied,
    not-found,
    not-ready,
    invalid,
    over-budget,
    stale,
    unsupported,
    io,
  }


  record harness-metrics {
    harness: string,
    agents: u32,
    input-tokens: u64,
    output-tokens: u64,
    tool-calls: u64,
    tool-errors: u64,
    tokens-per-second-milli: u64,
    measured-agents: u32,
  }

  record report {
    since-ms: u64,
    until-ms: u64,
    agents: u32,
    active: u32,
    needs-you: u32,
    input-tokens: u64,
    output-tokens: u64,
    turns: u32,
    tool-calls: u64,
    tool-errors: u64,
    /// sum(output-tokens) * 1000 / sum(model-time-ms)
    tokens-per-second-milli: u64,
    measured-agents: u32,
    by-harness: list<harness-metrics>,
  }

  stats: func(since-ms: option<u64>, until-ms: option<u64>)
    -> result<report, error>;
}

interface dispatch {
  enum error {
    denied,
    not-found,
    not-ready,
    invalid,
    over-budget,
    stale,
    unsupported,
    io,
  }


  record task {
    text: string,
    /// Adapter family: "theseus", "acp", "rakazo", "muse".
    harness: string,
    /// Device label, never a hostname guess.
    environment: string,
    title: option<string>,
    model: option<string>,
  }

  record started {
    agent-id: string,
    conversation: string,
  }

  dispatch: func(task: task) -> result<started, error>;
}

interface cli {
  run: func(args: list<string>) -> result<string, string>;
}

world acp-agents {
  import soil:http/http@0.2.0;
  import soil:vfs/vfs@1.0.0;
  import soil:vfs-mut/vfs-mut@0.1.0;

  export observe;
  export control;
  export metrics;
  export dispatch;
  export cli;
}
