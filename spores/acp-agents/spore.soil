; Source manifest for the ACP-over-HTTP adapter.
;
; The host decides whether these origins are reachable and what the handle
; resolves to. No secret, reference or purpose lives in the package.
(spore
  (id "dev.fungos.acp-agents")
  (name "acp-agents")
  (version "0.1.0")
  (module "module.wasm")
  (grants
    ("fungos:acp-agents" "the adapter exports these interfaces")
    ("soil:http" "reach the ACP endpoint the host allowlists")
    ("soil:vfs" "read agents/acp.json for the endpoint"))
  (http-client
    (origin "http://127.0.0.1:8791")
    (credential "default")))
