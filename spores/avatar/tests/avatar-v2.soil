(defun av2/test-same-seed ()
  (= (av2/render "v2-orb-1" "orb" 0 0) (av2/render "v2-orb-1" "orb" 0 0)))
(defun av2/test-family-distinct ()
  (not (= (av2/render "v2-x" "orb" 0 0) (av2/render "v2-x" "visor" 0 0))))
(defun av2/test-variant-distinct ()
  (not (= (av2/render "v2-x" "organic" 0 0) (av2/render "v2-x" "organic" 1 0))))
(defun av2/test-frames-differ ()
  (not (= (av2/render "v2-x" "sentinel" 0 0) (av2/render "v2-x" "sentinel" 0 3))))
(defun av2/test-version () (= (av2/style-version) "v2"))
(defun av2/test-self-contained ()
  (let ((s (av2/render "v2-x" "orb" 2 0)))
    (and (string-contains? s "<svg") (not (string-contains? s "href='http")))))
(if (av2/test-same-seed) (println "PASS v2-same-seed") (println "FAIL v2-same-seed"))
(if (av2/test-family-distinct) (println "PASS v2-family-distinct") (println "FAIL v2-family-distinct"))
(if (av2/test-variant-distinct) (println "PASS v2-variant-distinct") (println "FAIL v2-variant-distinct"))
(if (av2/test-frames-differ) (println "PASS v2-frames-differ") (println "FAIL v2-frames-differ"))
(if (av2/test-version) (println "PASS v2-version") (println "FAIL v2-version"))
(if (av2/test-self-contained) (println "PASS v2-self-contained") (println "FAIL v2-self-contained"))
