(defun avatar/test-same-seed ()
  (= (avatar/render "atlas-01" "fold") (avatar/render "atlas-01" "fold")))
(defun avatar/test-different-seeds ()
  (not (= (avatar/render "atlas-01" "fold") (avatar/render "atlas-02" "fold"))))
(defun avatar/test-style-version ()
  (= (avatar/style-version) "v1"))
(defun avatar/test-self-contained ()
  (and (string-contains? (avatar/render "atlas-03" "fold") "<svg")
       (not (string-contains? (avatar/render "atlas-03" "fold") "href='http"))))
(defun avatar/test-styles-differ ()
  (not (= (avatar/render "atlas-04" "fold") (avatar/render "atlas-04" "orbit"))))
(defun avatar/test-all-styles ()
  (and (string-contains? (avatar/render "atlas-05" "fold") "Synthetic identity mark")
       (string-contains? (avatar/render "atlas-05" "orbit") "Synthetic identity orbit")
       (string-contains? (avatar/render "atlas-05" "signal") "Synthetic identity signal")))
(if (avatar/test-same-seed) (println "PASS same-seed") (println "FAIL same-seed"))
(if (avatar/test-different-seeds) (println "PASS different-seeds") (println "FAIL different-seeds"))
(if (avatar/test-style-version) (println "PASS style-version") (println "FAIL style-version"))
(if (avatar/test-self-contained) (println "PASS self-contained") (println "FAIL self-contained"))
(if (avatar/test-styles-differ) (println "PASS styles-differ") (println "FAIL styles-differ"))
(if (avatar/test-all-styles) (println "PASS all-styles") (println "FAIL all-styles"))
