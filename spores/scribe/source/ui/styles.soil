

; SPDX-License-Identifier: MIT OR Apache-2.0
; Scribe's stylesheet, as Soil text.
;
; One palette, two layouts. The host owns the <style> element; this is the whole
; of the presentation. No client JavaScript and no runtime CSS framework.

(defun views/styles ()
  (str
    ":root{--bg:#faf8f4;--panel:#f3efe7;--surface:#fff;--hover:#f0ebe2;--active:#ece6dc;"
    "--soft:#eee8de;--ink:#1d1b18;--muted:#7b7266;--line:#e4ddd2;--accent:#2f6f56;"
    "--accent-soft:#e3eee7;--shadow:0 8px 24px rgba(30,25,20,.12);color-scheme:light}\n"
    "@media (prefers-color-scheme:dark){:root{--bg:#151412;--panel:#201e1a;--surface:#24211d;"
    "--hover:#2a2621;--active:#332e27;--soft:#302b25;--ink:#f3eee5;--muted:#a79d8f;"
    "--line:#3a352e;--accent:#8fd0aa;--accent-soft:#263a2f;color-scheme:dark}}\n"
    "*{box-sizing:border-box}html,body{margin:0;min-height:100%}"
    "body{background:var(--bg);color:var(--ink);font:14px/1.55 ui-sans-serif,-apple-system,"
    "BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n"
    "a{color:inherit;text-decoration:none}button,input,textarea{font:inherit;color:inherit}\n"
    "header{display:flex;align-items:center;gap:12px;height:58px;padding:0 22px;"
    "border-bottom:1px solid var(--line)}\n"
    ".brand{font-family:ui-serif,Georgia,serif;font-size:23px;letter-spacing:-.03em}"
    ".brand b{color:var(--accent)}.tag{font-size:10px;text-transform:uppercase;"
    "letter-spacing:.13em;color:var(--muted);border:1px solid var(--line);border-radius:999px;"
    "padding:2px 7px}.spacer{flex:1}\n"
    "main{display:grid;grid-template-columns:268px minmax(0,1fr);min-height:calc(100vh - 58px)}\n"
    "aside{border-right:1px solid var(--line);padding:12px 10px;overflow:auto;"
    "height:calc(100vh - 58px);position:sticky;top:0}\n"
    ".filters{display:flex;flex-direction:column;gap:6px;padding:0 6px 12px;"
    "border-bottom:1px solid var(--line);margin-bottom:8px}\n"
    ".filters input[type=search],.filters input[type=date]{width:100%;font-size:12px;"
    "padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--surface)}\n"
    ".dates{display:flex;gap:5px;align-items:center;min-width:0}.dates span{color:var(--muted)}.dates input{min-width:0;flex:1}\n"
    ".row{display:flex;gap:6px;align-items:center}.row .grow{flex:1}\n"
    "button{cursor:pointer;border:1px solid var(--line);background:transparent;"
    "border-radius:7px;padding:5px 10px}button:hover{background:var(--hover)}\n"
    "button.primary{background:var(--accent);border-color:var(--accent);color:var(--bg)}\n"
    ".link{font-size:11px;color:var(--muted)}.link:hover{color:var(--ink)}\n"
    ".section-title{font-size:9px;text-transform:uppercase;letter-spacing:.14em;"
    "color:var(--muted);padding:4px 7px}\n"
    ".capture{display:block;padding:8px;border-radius:8px;margin:1px 0}"
    ".capture:hover{background:var(--hover)}.capture.active{background:var(--active)}"
    ".capture .title{font-weight:560;font-size:13px;line-height:1.3;overflow:hidden;"
    "text-overflow:ellipsis;white-space:nowrap}.capture .when{font-size:10px;color:var(--muted);"
    "margin-top:2px}.capture .preview{font-size:11px;color:var(--muted);margin-top:3px;"
    "display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n"
    ".center{padding:30px 42px 60px;overflow:auto;max-width:1100px}\n"
    "h1{font-family:ui-serif,Georgia,serif;font-size:34px;line-height:1.14;"
    "letter-spacing:-.035em;margin:0 0 7px}\n"
    ".meta{color:var(--muted);font-size:12px;margin-bottom:26px}.meta .dot{margin:0 6px}\n"
    ".grid{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:34px;align-items:start}\n"
    ".summary{font-size:15px;line-height:1.68}.summary h2{font-family:ui-serif,Georgia,serif;"
    "font-size:21px;letter-spacing:-.02em;margin:22px 0 8px}.summary h3{font-size:16px;"
    "margin:16px 0 6px}.summary p{margin:0 0 12px}.summary ul{margin:0 0 12px;padding-left:22px}\n"
    "h2.block{font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);"
    "margin:30px 0 8px}\n"
    ".turn{padding:9px 0;border-bottom:1px solid var(--line)}.speaker{font-size:10px;"
    "color:var(--muted);text-transform:uppercase;letter-spacing:.09em;margin-bottom:3px}"
    ".text{white-space:pre-wrap;font-size:15px;line-height:1.7}\n"
    ".actions{border-left:1px solid var(--line);padding-left:18px}.action{padding:10px 0;"
    "border-bottom:1px solid var(--line)}.action .title{font-weight:560;line-height:1.35}"
    ".action .quote{color:var(--muted);font-size:12px;margin-top:5px;padding-left:9px;"
    "border-left:2px solid var(--accent)}.action .who{font-size:11px;color:var(--muted);"
    "margin-top:5px}\n"
    ".panel{border:1px solid var(--line);border-radius:10px;padding:12px;background:var(--panel);"
    "margin:0 0 12px}.panel h3{margin:0 0 8px;font-size:12px;text-transform:uppercase;"
    "letter-spacing:.1em;color:var(--muted)}.panel label{display:block;font-size:11px;"
    "color:var(--muted);margin:6px 0 3px}\n"
    ".panel input[type=text],.panel textarea{width:100%;padding:6px 8px;border:1px solid "
    "var(--line);border-radius:6px;background:var(--surface)}\n"
    ".panel textarea{min-height:220px;resize:vertical;font:12px/1.5 ui-monospace,Menlo,monospace}\n"
    ".empty{color:var(--muted);padding:40px 4px;font-size:13px}\n"
    ".pill{display:inline-block;font-size:10px;color:var(--accent);background:var(--accent-soft);"
    "border-radius:999px;padding:1px 6px;margin-left:4px}\n"
    "@media(max-width:860px){main{display:block}aside{height:auto;position:static;"
    "border-right:0;border-bottom:1px solid var(--line)}.grid{grid-template-columns:1fr}"
    ".actions{border-left:0;padding-left:0}.center{padding:22px 18px}}\n"))
